{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence comparison, version 1",
  "description": "The JSON response of the offline comparison command.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_origin", "omitted_passages", "decisions"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "evidence_origin": {"enum": ["synthetic", "published"]},
    "omitted_passages": {
      "type": "array", "items": {"$ref": "casebook.schema.json#/$defs/Text"}, "uniqueItems": true
    },
    "decisions": {"type": "array", "minItems": 1, "items": {"$ref": "decision.schema.json"}}
  },
  "if": {"properties": {"evidence_origin": {"const": "published"}}},
  "then": {"properties": {"decisions": {"items": {"properties": {
    "ledger": {"items": {"$ref": "casebook.schema.json#/$defs/BibliographyRequired"}}
  }}}}},
  "else": {"properties": {"decisions": {"items": {"properties": {
    "ledger": {"items": {"$ref": "casebook.schema.json#/$defs/BibliographyAbsent"}}
  }}}}}
}
